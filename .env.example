# Local development defaults. Copy to `.env` if you want a dotenv loader; services also
# read these names directly from the process environment.

DATABASE_URL=postgres://cascade:cascade@localhost:5432/cascade?sslmode=disable
DB_USER=cascade
DB_PASSWORD=cascade
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

POST_SERVICE_GRPC_PORT=9090
POST_SERVICE_ADDR=localhost:9090
POST_CACHE_TTL=6h
POST_TOMBSTONE_TTL=24h

FEED_SERVICE_GRPC_PORT=9091
FEED_SERVICE_ADDR=localhost:9091

SOCIAL_GRAPH_BASE_URL=http://localhost:8081
CELEBRITY_THRESHOLD=10000

GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
GATEWAY_GRPC_DEADLINE=5s
PROMETHEUS_URL=http://localhost:9095

POST_METRICS_ADDR=:9100
FEED_METRICS_ADDR=:9101
FANOUT_METRICS_ADDR=:9102

# Phase 12 baseline: set both to true and recreate feed-service / post-service.
FEED_BYPASS_CACHE=false
POST_BYPASS_CACHE=false

NEXT_PUBLIC_API_BASE=http://localhost:8080

TOMBSTONE_TTL=24h
MAX_TIMELINE_LEN=1000
BACKFILL_COUNT=20
CELEBRITY_FOLLOWER_THRESHOLD=10000
